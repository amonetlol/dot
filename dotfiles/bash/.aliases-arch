# ~/.aliases-arch
# Aliases específicos para Arch Linux (yay/pacman/reflector)

alias up2='yay -Syyu --noconfirm'
alias yay='yay --noconfirm'
alias yin='yay --noconfirm -S'
alias yse='yay -Ss'
# yse2 <termo...> [-x|-v <excluir>]...  — pesquisa (yay -Ss) removendo pacotes cujo NOME case com o padrão excluído (regex, sem diferenciar maiúsculas)
#   yse2 linux -x linux-f              -> linux sem linux-firmware*
#   yse2 linux -x 'linux-f|api' -x lts -> várias exclusões (cada -x é uma regex; também aceita |)
yse2() {
    local ex=() q=() pat
    while (($#)); do
        case "$1" in
            -x|-v|--exclude) [[ -n ${2-} ]] || { echo "yse2: $1 precisa de um padrão" >&2; return 1; }; ex+=("$2"); shift 2 ;;
            -h|--help) echo "uso: yse2 <termo...> [-x|-v <excluir>]..."; return 0 ;;
            *) q+=("$1"); shift ;;
        esac
    done
    ((${#q[@]})) || { echo "uso: yse2 <termo...> [-x|-v <excluir>]..." >&2; return 1; }
    pat=$(IFS='|'; echo "${ex[*]}")
    yay -Ss "${q[@]}" | awk -v pat="$pat" 'BEGIN{IGNORECASE=1} /^[^ \t]/ { n=$1; sub(/^[^\/]*\//,"",n); skip=(pat!="" && n ~ pat) } !skip'
}
alias ysel='yay -Qq | grep'
alias yre='yay --noconfirm -Rns'
alias yinfo='yay -Si'
alias cls='sudo pacman -Scc --noconfirm && yay -Sc --noconfirm'
alias rpac='sudo reflector --country Brazil --latest 10 --sort rate --save /etc/pacman.d/mirrorlist'
alias orf='sudo pacman -Qtdq | sudo pacman -Rns -'
