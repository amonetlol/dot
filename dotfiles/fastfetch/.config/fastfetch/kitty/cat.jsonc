{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
    "source": "cat.png",
    "type": "kitty",
    //"type": "sixel",
    "width": 20,
    "height": 22,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    },

    "color": {
      "1": "38;2;180;190;254",
      "2": "38;2;180;190;254",
      "3": "38;2;180;190;254",
      "4": "38;2;180;190;254",
      "5": "38;2;180;190;254",
      "6": "38;2;180;190;254"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "0;38;2;180;190;254"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[0;38;2;180;190;254m╭───────────────────────── System ───────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "│ 󰣇 OS          ",
    },
    {
      "type": "board",
      "key": "│ 󰌢 Host        ",
      "format": "{1}"
    },
    {
      "type": "kernel",
      "key": "│  Kernel      ",
      "format": "{1}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime      "
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages    ",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "\u001b[0;38;2;180;190;254m├───────────────────────── Desktop ──────────────────────┤\u001b[0m"
    },
    {
      "type": "de",
      "key": "│ 󰧨 DE          ",
      "format": "{1}"
    },
    {
      "type": "wm",
      "key": "│  WM          ",
      "format": "{1}"
    },
    {
      "type": "icons",
      "key": "│ 󰀻 Icons       ",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "│  Terminal    ",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": "│  Shell       ",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "\u001b[0;38;2;180;190;254m├──────────────────────── Hardware ──────────────────────┤\u001b[0m"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display     ",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "cpu",
      "key": "│  CPU         ",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU         ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "│  Memory      ",
      "format": "{1} / {2}"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Disk        ",
      "format": "{1} / {2}"
    },
    {
      "type": "battery",
      "key": "│  Battery     "
    },
    {
      "type": "custom",
      "format": "\u001b[0;38;2;180;190;254m╰────────────────────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
