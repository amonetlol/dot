{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " │ ",
    "bar": {
      "char": {
        "elapsed": "─",
        "total": "─"
      },
      "width": 13
    },
    "percent": {
      "type": 15
    },
    "key": {
      "width": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": " ",
      "format": "{user-name-colored} {at-symbol-colored} {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#cyan}╭───────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#cyan}│ {#magenta}󰣇 OS      ",
      "format": "{name<32} {#cyan}│",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "{#cyan}│ {#magenta} WM      ",
      "format": "{pretty-name<32} {#cyan}│"
    },
    {
      "type": "terminal",
      "key": "{#cyan}│ {#magenta} Terminal",
      "format": "{pretty-name<32} {#cyan}│"
    },
    {
      "type": "shell",
      "key": "{#cyan}│ {#magenta} Shell   ",
      "format": "{pretty-name<32} {#cyan}│",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "{#cyan}╰───────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "host",
      "format": "{#green}{vendor} {name}",
      "key": "{#green}  ",
      "keyColor": "33"
    },
    {
      "type": "custom",
      "format": "{#green}╭───────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "format": "{name<32} {#green}│",
      "key": "{#green}│ {#blue} CPU     "
    },
    {
      "type": "gpu",
      "format": "{name<32} {#green}│",
      "key": "{#green}│ {#blue}󰊴 GPU     "
    },
    {
      "type": "memory",
      "key": "{#green}│ {#blue}󰑭 Memory  ",
      "format": "{percentage-bar}                {#green}│"
    },
    {
      "type": "disk",
      "key": "{#green}│ {#blue}󰋊 Disk    ",
      "folders": "/",
      "format": "{size-percentage-bar}                {#green}│"
    },
    {
      "type": "battery",
      "key": "{#green}│ {#blue}󰁹 Battery ",
      "format": "{capacity-bar}                {#green}│"
    },
    {
      "type": "command",
      "key": "{#green}│ {#blue}󱦟 OS Age  ",
      "format": "{result<32} {#green}│",
      "text": "t=$(stat -c %W / 2>/dev/null || printf 0); if [ \"${t:-0}\" -gt 0 ]; then printf '%s dias' \"$(( ($(date +%s) - t) / 86400 ))\"; else printf 'N/D'; fi"
    },
    {
      "type": "custom",
      "format": "{#green}╰───────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
