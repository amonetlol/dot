# Fedora Silverblue: alteracoes de pacotes entram no proximo boot.
alias up2='rpm-ostree upgrade'
alias yay='rpm-ostree'
alias yin='sudo rpm-ostree install'
alias yse='rpm-ostree search'
alias ysel='rpm -qa | grep -i'
alias yre='sudo rpm-ostree uninstall'
alias yinfo='rpm -qi'
alias cls='sudo rpm-ostree cleanup -m'
alias rpac='sudo rpm-ostree refresh-md'
# rpm-ostree nao possui equivalente a remocao automatica de orfaos.
alias orf='rpm-ostree status'
