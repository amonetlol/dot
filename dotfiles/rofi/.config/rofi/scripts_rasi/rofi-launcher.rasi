/* list-compact.rasi — ultra compatible */
configuration{
  modi:         "drun,run,window,combi,filebrowser";
  combi-modi:   "drun,window";
  show-icons:   true;
  display-drun: "";
  font:         "JetBrainsMono NFM 11"; 
}

window {
  width: 700;
  padding: 10;
  border: 0;
  border-radius: 14;
  background-color: #1e1e2e;
}

mainbox {
  spacing: 10;
  background-color: transparent;
}

inputbar {
  padding: 8 10;
  border-radius: 14;
  background-color: #1e1e2e;
  text-color: #74c7ec;
  children: [ prompt, entry ];
}

prompt {
  enabled: true;
  margin: 0 10 0 0;
  background-color: transparent;
  text-color: #89b4fa;
}

textbox-prompt-colon { enabled: false; }
case-indicator { enabled: false; }

entry {
  background-color: transparent;
  text-color: #74c7ec;
  placeholder: "Search…";
  placeholder-color: #6c7086;
}

listview {
  lines: 12;
  fixed-height: false;
  spacing: 2;
  padding: 2;
  scrollbar: false;
  background-color: transparent;
}

element {
  padding: 6 10;
  border: 0;
  border-radius: 10;
  background-color: transparent;
  text-color: #74c7ec;
}

element selected {
  background-color: #89b4fa;
  text-color: #1e1e2e;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

element-icon {
  background-color: transparent;
  padding: 2;
  enabled: true;
  size: 14px;
}

message {
  background-color: transparent;
  text-color: #f38ba8;
}

error-message {
  background-color: transparent;
  text-color: #f38ba8;
}
