# Aliases GhostBSD: pkg pergunta antes de instalar, atualizar ou remover.
alias up2='sudo pkg upgrade'
alias yay='pkg'
alias yin='sudo pkg install'
alias yse='pkg search'
alias ysel='pkg info | grep'
alias yre='sudo pkg delete'
alias yinfo='pkg info -x'
alias cls='sudo pkg clean'
alias rpac='sudo pkg update -f'
alias orf='sudo pkg autoremove'
