#!/usr/bin/env python3
from pathlib import Path
import subprocess
root = Path(__file__).resolve().parent
with (root / 'SHORTCUTS.txt').open() as guide:
    result = subprocess.run(['/usr/bin/rofi', '-no-config', '-dmenu', '-i', '-no-show-icons', '-scroll-method', '1', '-no-cycle', '-p', 'Atalhos Kitty', '-mesg', 'Esc para fechar', '-theme', str(root / 'rofi/hotkeys.rasi')], stdin=guide, stdout=subprocess.DEVNULL)
raise SystemExit(0 if result.returncode in (0, 1) else result.returncode)
