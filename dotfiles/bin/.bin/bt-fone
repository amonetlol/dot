#!/usr/bin/env bash
# Conectar/desconectar fone Bluetooth com reconexão automática no Arch Linux
set -euo pipefail

DEVICE="70:50:E7:83:05:C4"
DEVICE_MAC="${DEVICE//:/_}"
NAME="Fone Bluetooth"

MAX_RETRIES="${BT_MAX_RETRIES:-15}"
RETRY_DELAY="${BT_RETRY_DELAY:-2}"
CONNECT_WAIT="${BT_CONNECT_WAIT:-4}"
WATCH_COOLDOWN="${BT_WATCH_COOLDOWN:-45}"
BLUETOOTH_ENABLE_WAIT="${BT_ENABLE_WAIT:-8}"

# Erros mapeados da screenshot (Archcraft/Arch Linux + PipeWire)
# 1) pipewire: bluez_output.MAC idle -> error (Received error event)
# 2) bluetoothd: No matching connection for device
ERROR_PATTERNS=(
    "bluez_output.${DEVICE_MAC}.*idle -> error"
    "Received error event"
    "No matching connection for device"
    "br-connection-profile-unavailable"
    "br-connection-create-socket"
    "Protocol not available"
    "Connection refused"
    "org.bluez.Error.Failed"
    "org.bluez.Error.NotAvailable"
    "Host is down"
    "connect error"
)

usage() {
    cat <<EOF
Uso: $(basename "$0") [comando]

Comandos:
  connect     Conecta com retry automático até sucesso (padrão)
  disconnect  Desconecta o fone
  toggle      Conecta se desconectado, desconecta se conectado
  status      Mostra status atual
  errors      Mostra erros recentes do Bluetooth no journal (útil para mapear)
  watch       Monitora o journal e reconecta ao detectar erro

Variáveis de ambiente:
  BT_MAX_RETRIES   Tentativas máximas (padrão: $MAX_RETRIES)
  BT_RETRY_DELAY   Segundos entre tentativas (padrão: $RETRY_DELAY)
  BT_CONNECT_WAIT  Segundos para aguardar após connect (padrão: $CONNECT_WAIT)
  BT_ENABLE_WAIT   Segundos para aguardar o Bluetooth ligar (padrão: $BLUETOOTH_ENABLE_WAIT)

Exemplo:
  $(basename "$0") connect
  BT_MAX_RETRIES=20 $(basename "$0") connect
EOF
}

device_mac_underscores() {
    echo "$DEVICE_MAC"
}

card_name() {
    echo "bluez_card.$(device_mac_underscores)"
}

log() {
    echo "[$(date +%H:%M:%S)] $*"
}

is_connected() {
    bluetoothctl info "$DEVICE" 2>/dev/null | grep -q "Connected: yes"
}

has_bluez_card() {
    pactl list cards short 2>/dev/null | grep -q "$(card_name)"
}

a2dp_profile_available() {
    local card
    card="$(card_name)"
    pactl list cards 2>/dev/null | awk -v card="$card" '
        $1 == "Name:" && $2 == card { found=1 }
        found && /a2dp/ { print; exit }
    ' | grep -qiE 'a2dp[-_]sink|a2dp'
}

a2dp_is_active() {
    local card
    card="$(card_name)"
    pactl list cards 2>/dev/null | awk -v card="$card" '
        $1 == "Name:" && $2 == card { found=1 }
        found && /Active Profile:/ && /a2dp/ { print; exit }
    ' | grep -q .
}

has_audio_sink() {
    pactl list sinks short 2>/dev/null | grep -q "bluez_output.${DEVICE_MAC}"
}

# Critério prático: bluetooth conectado + áudio funcionando
is_connected_ok() {
    is_connected && { has_audio_sink || a2dp_is_active || a2dp_profile_available; }
}

is_fully_connected() {
    is_connected_ok
}

set_a2dp_profile() {
    local card profile
    card="$(card_name)"
    if has_bluez_card; then
        for profile in a2dp-sink-sbc a2dp-sink-sbc_xq a2dp-sink; do
            if pactl set-card-profile "$card" "$profile" 2>/dev/null; then
                log "Perfil de áudio definido: $profile"
                return 0
            fi
        done
        log "Não consegui forçar perfil A2DP estável; mantendo perfil atual."
    fi
}

journal_since() {
    local since="$1"
    journalctl -u bluetooth.service -u bluetooth -u pipewire -u pipewire.service \
        --since "$since" --no-pager 2>/dev/null \
        || journalctl --since "$since" --no-pager 2>/dev/null
}

line_is_for_device() {
    local line="$1"
    echo "$line" | grep -qiE "${DEVICE_MAC}|${DEVICE//:/}|bluez_(output|input)\.${DEVICE_MAC}"
}

line_matches_error() {
    local line="$1"

    if echo "$line" | grep -qi "No matching connection for device"; then
        return 0
    fi

    if ! line_is_for_device "$line"; then
        return 1
    fi

    if echo "$line" | grep -q "bluez_output.${DEVICE_MAC}.*idle -> error"; then
        return 0
    fi

    if echo "$line" | grep -qi "Received error event"; then
        return 0
    fi

    if echo "$line" | grep -qiE "br-connection-profile-unavailable|br-connection-create-socket|Protocol not available"; then
        return 0
    fi

    return 1
}

check_journal_errors() {
    local since="$1"
    local line

    while IFS= read -r line; do
        if line_matches_error "$line"; then
            log "Erro detectado no journal: $line"
            return 0
        fi
    done < <(journal_since "$since" | grep -iE "${DEVICE_MAC}|bluez_output\.${DEVICE_MAC}|No matching connection")

    return 1
}

force_disconnect() {
    bluetoothctl disconnect "$DEVICE" 2>/dev/null || true
    sleep 1
}

bluetooth_is_on() {
    bluetoothctl show 2>/dev/null | grep -q "Powered: yes"
}

ensure_bluetooth_on() {
    local elapsed=0

    if bluetooth_is_on; then
        return 0
    fi

    log "Bluetooth está desligado. Ligando adaptador..."

    # O adaptador pode estar bloqueado por rfkill. Enquanto estiver bloqueado,
    # bluetoothctl power on retorna NotReady/Failed e não consegue habilitá-lo.
    rfkill unblock bluetooth 2>/dev/null || true
    bluetoothctl power on >/dev/null 2>&1 || true

    # Após o unblock, o BlueZ pode permanecer em "off-enabling" por alguns segundos.
    while (( elapsed < BLUETOOTH_ENABLE_WAIT )); do
        if bluetooth_is_on; then
            log "Bluetooth ligado. Continuando conexão..."
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    log "Não foi possível ligar o Bluetooth. Verifique o bloqueio rfkill e o adaptador."
    return 1
}

prepare_bluetooth() {
    ensure_bluetooth_on
    bluetoothctl trust "$DEVICE" >/dev/null 2>&1 || true
}

single_connect_attempt() {
    local since
    local did_connect=0
    since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    if ! prepare_bluetooth; then
        return 1
    fi

    if is_connected_ok; then
        log "Já conectado e com áudio OK."
        set_a2dp_profile
        return 0
    fi

    if is_connected; then
        log "Bluetooth conectado, ajustando perfil A2DP..."
        set_a2dp_profile
        sleep 1
        if is_connected_ok; then
            return 0
        fi
    else
        log "Tentando conectar $NAME ($DEVICE)..."
        bluetoothctl connect "$DEVICE" 2>/dev/null || true
        did_connect=1
        sleep "$CONNECT_WAIT"
    fi

    if [[ "$did_connect" -eq 1 ]] && check_journal_errors "$since"; then
        return 1
    fi

    if ! is_connected; then
        log "Dispositivo não ficou conectado"
        return 1
    fi

    set_a2dp_profile
    sleep 1

    if is_connected_ok; then
        return 0
    fi

    if ! has_bluez_card && ! has_audio_sink; then
        log "Card/sink PipeWire não apareceu"
        return 1
    fi

    log "Conectado, mas áudio ainda não está pronto"
    return 1
}

cmd_connect() {
    local attempt=1

    log "=== Conexão automática: $NAME ==="

    if is_connected_ok; then
        log "Já conectado com áudio OK. Nada a fazer."
        return 0
    fi

    while [ "$attempt" -le "$MAX_RETRIES" ]; do
        log "Tentativa $attempt/$MAX_RETRIES"

        if single_connect_attempt; then
            log "Conectado com sucesso!"
            pactl list cards short 2>/dev/null | grep "$(card_name)" || true
            return 0
        fi

        if is_connected_ok; then
            log "Conexão recuperou durante a tentativa."
            return 0
        fi

        log "Falha na tentativa $attempt."
        if is_connected; then
            log "Desconectando para tentar novamente em ${RETRY_DELAY}s..."
            force_disconnect
        else
            log "Aguardando ${RETRY_DELAY}s antes da próxima tentativa..."
        fi
        sleep "$RETRY_DELAY"
        attempt=$((attempt + 1))
    done

    log "Falhou após $MAX_RETRIES tentativas."
    log "Execute: $(basename "$0") errors   (para ver o erro exato no journal)"
    return 1
}

cmd_disconnect() {
    log "Desconectando $NAME ($DEVICE)..."
    force_disconnect
    log "Desconectado."
}

cmd_toggle() {
    if is_connected; then
        cmd_disconnect
    else
        cmd_connect
    fi
}

cmd_status() {
    echo "=== $NAME ($DEVICE) ==="
    bluetoothctl info "$DEVICE" 2>/dev/null | grep -E "Connected:|Paired:|Trusted:|Name:" || echo "Dispositivo não encontrado"
    echo
    if has_bluez_card; then
        echo "Card: $(card_name)"
        pactl list cards 2>/dev/null | awk -v card="$(card_name)" '
            $1 == "Name:" && $2 == card { found=1 }
            found && /Active Profile:/ { print "Perfil ativo:", $0 }
            found && /a2dp_sink/ && /available/ { print $0 }
        '
    else
        echo "Card PulseAudio/PipeWire: não encontrado"
    fi
    if has_audio_sink; then
        echo "Sink: $(pactl list sinks short 2>/dev/null | grep "bluez_output.${DEVICE_MAC}" | awk '{print $2}')"
    else
        echo "Sink de áudio: não encontrado"
    fi
    echo
    if is_connected_ok; then
        echo "Status: OK (conectado + áudio)"
    else
        echo "Status: incompleto (precisa reconectar)"
    fi
}

cmd_errors() {
    echo "=== Erros recentes do Bluetooth/PipeWire (últimos 5 min) ==="
    echo "Erros mapeados da screenshot:"
    echo "  - pipewire: bluez_output.${DEVICE_MAC} idle -> error (Received error event)"
    echo "  - bluetoothd: No matching connection for device"
    echo
    journal_since "5 minutes ago" | grep -iE \
        "pipewire|bluetoothd|bluez_output.${DEVICE_MAC}|No matching connection|Received error event|error|fail" \
        || echo "(nenhum erro encontrado)"
}

cmd_watch() {
    local last_reconnect=0
    local now

    log "Monitorando journal (pipewire + bluetoothd). Ctrl+C para parar."
    log "Dispositivo: $NAME ($DEVICE)"
    log "Reconecta só se o fone NÃO estiver OK (cooldown: ${WATCH_COOLDOWN}s)"
    echo

    journalctl -f --no-pager 2>/dev/null \
        | grep --line-buffered -iE "pipewire|bluetoothd|bluez_output\.${DEVICE_MAC}|No matching connection" \
        | while read -r line; do
            echo "$line"

            if ! line_matches_error "$line"; then
                continue
            fi

            if is_connected_ok; then
                log "Erro no log, mas fone OK — ignorando."
                continue
            fi

            now=$(date +%s)
            if (( now - last_reconnect < WATCH_COOLDOWN )); then
                log "Cooldown ativo, aguardando antes de reconectar..."
                continue
            fi

            last_reconnect=$now
            log "Erro detectado com fone fora do ar. Iniciando reconexão..."
            cmd_connect
        done
}

main() {
    local cmd="${1:-connect}"

    case "$cmd" in
        connect)   cmd_connect ;;
        disconnect) cmd_disconnect ;;
        toggle)    cmd_toggle ;;
        status)    cmd_status ;;
        errors)    cmd_errors ;;
        watch)     cmd_watch ;;
        -h|--help|help) usage ;;
        *)
            echo "Comando desconhecido: $cmd"
            usage
            exit 1
            ;;
    esac
}

main "$@"
