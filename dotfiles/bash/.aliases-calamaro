# ~/.aliases-calamaro
# CalamaroOS (Gentoo/portage): nomes de aliases como no .aliases-arch.
# up2 sem modo nao-interativo: o emerge lista os pacotes e pergunta antes de aplicar.

alias up2='sudo emerge --ask --update --deep --newuse @world'
alias upgrade='sudo emerge --ask --update --deep --newuse @world'
alias up-all='sudo emerge --update --deep --newuse @world && sudo emerge --ask --depclean'
alias yin='sudo emerge --ask'
alias yre='sudo emerge --ask --unmerge'
alias yse='emerge --search'
alias yinfo='emerge --pretend --verbose'
alias ysel='qlist -I | grep -i'

alias yay='sudo emerge'
alias rpac='sudo emaint sync -a'
alias orf='sudo emerge --ask --depclean'
alias cls='sudo eclean-dist -d && sudo eclean-pkg -d'
alias update-grub='sudo grub-mkconfig -o /boot/grub/grub.cfg'
alias al2='micro ~/.bashrc ~/.aliases ~/.aliases-calamaro ~/.functions'
