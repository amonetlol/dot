# ~/.aliases-salix
# Mesmos nomes de ~/.aliases-arch, adaptados para Salix (slapt-get).
# up2 atualiza o indice, lista os pacotes e espera confirmacao.

alias up2='sudo slapt-get --update && sudo slapt-get --upgrade'
alias yay='sudo slapt-get'
alias yin='sudo slapt-get --install'
alias yse='slapt-get --search'
alias ysel='find -L /var/log/packages -maxdepth 1 -type f -printf "%f\n" | sed "s/-[^-]*-[^-]*-[^-]*$//" | sort | grep'
alias yre='sudo slapt-get --remove'
alias yinfo='slapt-get --show'
alias cls='sudo slapt-get --clean'
alias rpac='sudo slapt-get --update'
alias orf='printf "%s\n" "Salix nao remove dependencias orfas automaticamente. Use yre para remover pacotes especificos."'
