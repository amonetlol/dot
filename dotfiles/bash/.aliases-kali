# ~/.aliases-kali
# Mesmos nomes de ~/.aliases-arch, adaptados para Kali (apt).
# Kali é base Debian: up2 confirma a atualização com -y.

alias up2='sudo apt update && sudo apt upgrade -y'
alias yay='sudo apt'
alias yin='sudo apt install -y'
alias yse='apt search'
alias ysel='apt list --installed | grep -i'
alias yre='sudo apt purge -y'
alias yinfo='apt show'
alias cls='sudo apt clean && sudo apt autoclean'
alias rpac='sudo apt update'
alias orf='sudo apt autoremove --purge -y'
