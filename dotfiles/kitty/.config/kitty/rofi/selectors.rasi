/* Centered dmenu theme for hypr script selectors */
@import "colors.rasi"

* {
    bg:       @background;
    bg-alt:   @background-alt;
    bg-sel:   @active;
    fg:       @foreground;
    accent:   @selected;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            480px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    24px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @bg;
    border-radius:    24px;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    24px 24px 0 0;
    padding:          16px 22px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: @accent;
    text-color:       @bg;
    padding:          5px 14px;
    border-radius:    12px;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search…";
    placeholder-color: #585b70;
    vertical-align:   0.5;
}

listview {
    background-color: @bg;
    border-radius:    0 0 24px 24px;
    columns:          1;
    lines:            12;
    spacing:          4px;
    padding:          12px;
    scrollbar:        false;
    fixed-height:     false;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          11px 15px;
    spacing:          12px;
    border-radius:    14px;
}

element selected.normal {
    background-color: @bg-sel;
    text-color:       @bg;
}

element-icon {
    size:             22px;
}

element-text {
    text-color: inherit;
    background-color: transparent;
    vertical-align:   0.5;
}
