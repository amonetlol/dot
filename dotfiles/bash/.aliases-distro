# ~/.aliases-distro
# Distro fora das bases arch/debian/fedora (Rocky Linux e outras): nomes de
# aliases iguais aos do .aliases-arch, comandos adaptados.
# up2 sem -y: lista os pacotes e pergunta antes de aplicar.

alias up2='sudo dnf upgrade'
alias upgrade='sudo dnf upgrade'
alias up-all='sudo dnf upgrade && sudo dnf autoremove'
alias yin='sudo dnf install -y'
alias yre='sudo dnf remove'
alias yse='dnf search'
alias yinfo='dnf info'
alias cls='sudo dnf clean all'
alias autoremove='sudo dnf autoremove'
alias ffix='sudo dnf distro-sync --refresh && sudo dnf upgrade --refresh'
alias ysel='dnf list --installed | grep -i'

alias yay='sudo dnf'
alias rpac='sudo dnf makecache --refresh'
alias orf='sudo dnf autoremove'
alias update-grub='sudo grub2-mkconfig -o /boot/grub2/grub.cfg'
alias al2='micro ~/.bashrc ~/.aliases ~/.aliases-distro ~/.functions'
